<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Haven theme, Dark appearance (spec 34-39).  Flat token set:
         ThemeService swaps one merged dictionary for another live, and the
         window root's RequestedTheme flips the framework controls. -->
            <Color x:Key="HavenCanvasColor">#0B1220</Color>
            <Color x:Key="HavenSurface1Color">#111A2C</Color>
            <Color x:Key="HavenSurface2Color">#172238</Color>
            <Color x:Key="HavenTextColor">#F3F6FC</Color>
            <Color x:Key="HavenMutedTextColor">#8E9BB4</Color>
            <Color x:Key="HavenStrokeColor">#27354F</Color>
            <Color x:Key="HavenHoverColor">#22FFFFFF</Color>

            <Color x:Key="HavenAccentColor">#3B82F6</Color>
            <Color x:Key="HavenAccentHoverColor">#5B96F5</Color>
            <Color x:Key="HavenVioletColor">#8B5CF6</Color>
            <Color x:Key="HavenOrangeColor">#FF8A3D</Color>
            <Color x:Key="HavenSuccessColor">#22C55E</Color>
            <Color x:Key="HavenWarningColor">#F59E0B</Color>
            <Color x:Key="HavenDangerColor">#EF4444</Color>
            <Color x:Key="HavenAccentTintColor">#333B82F6</Color>
            <Color x:Key="HavenVioletTintColor">#338B5CF6</Color>
            <Color x:Key="HavenOrangeTintColor">#33FF8A3D</Color>
            <Color x:Key="HavenSuccessTintColor">#3322C55E</Color>
            <Color x:Key="HavenWarningTintColor">#33F59E0B</Color>
            <Color x:Key="HavenDangerTintColor">#33EF4444</Color>
            <Color x:Key="HavenFocusRingColor">#993B82F6</Color>
            <Color x:Key="HavenPermissionGlowColor">#408B5CF6</Color>

            <LinearGradientBrush x:Key="HavenCanvasGradient" StartPoint="0,0" EndPoint="0.15,1">
                <GradientStop Color="#080D18" Offset="0" />
                <GradientStop Color="#0B1220" Offset="0.55" />
                <GradientStop Color="#0E1A2E" Offset="0.82" />
                <GradientStop Color="#14303A" Offset="0.95" />
                <GradientStop Color="#1B2E4A" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HavenSplashGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#080D18" Offset="0" />
                <GradientStop Color="#0B1220" Offset="0.6" />
                <GradientStop Color="#152A44" Offset="0.9" />
                <GradientStop Color="#4A2E1B" Offset="1" />
            </LinearGradientBrush>
</ResourceDictionary>
