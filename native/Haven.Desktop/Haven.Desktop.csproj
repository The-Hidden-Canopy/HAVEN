<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Haven.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <UseRidGraph>true</UseRidGraph>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsAppSDKVersion Condition="'$(WindowsAppSDKVersion)' == ''">2.5.1</WindowsAppSDKVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSDKVersion)" />
    <!-- Build/Ship/Shape WP2: the native-hosted MCP endpoint (spec section 9.1
         prefers a maintained SDK over hand-rolled JSON-RPC). -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel hosts the local-only MCP loopback endpoint inside this process. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- HavenEventClient + EventClientCoordinator live in a plain net8.0
         library (no WinUI types) so native-proof-loop work (the product
         plan's P0 "deterministic tests for concurrent reconnect requests,
         stall callback, shutdown during reconnect and token/pipe
         replacement") can unit-test the pipe lifecycle without a WinUI
         test host. -->
    <ProjectReference Include="..\Haven.Core.Client\Haven.Core.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\haven\web\static\haven-logo-light.png">
      <Link>Assets\haven-logo-light.png</Link>
    </Content>
    <Content Include="..\..\haven\web\static\haven-logo-dark.png">
      <Link>Assets\haven-logo-dark.png</Link>
    </Content>
  </ItemGroup>
</Project>
