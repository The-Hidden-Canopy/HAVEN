<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ember theme, Light appearance (spec 34-39).  Flat token set:
         ThemeService swaps one merged dictionary for another live, and the
         window root's RequestedTheme flips the framework controls. -->
            <Color x:Key="HavenCanvasColor">#FBF7F4</Color>
            <Color x:Key="HavenSurface1Color">#FFFFFF</Color>
            <Color x:Key="HavenSurface2Color">#F5EDE8</Color>
            <Color x:Key="HavenTextColor">#2B211D</Color>
            <Color x:Key="HavenMutedTextColor">#75655F</Color>
            <Color x:Key="HavenStrokeColor">#E7D7CC</Color>
            <Color x:Key="HavenHoverColor">#14000000</Color>

            <Color x:Key="HavenAccentColor">#EA580C</Color>
            <Color x:Key="HavenAccentHoverColor">#C74A0A</Color>
            <Color x:Key="HavenVioletColor">#8B5CF6</Color>
            <Color x:Key="HavenOrangeColor">#EA580C</Color>
            <Color x:Key="HavenSuccessColor">#22C55E</Color>
            <Color x:Key="HavenWarningColor">#F59E0B</Color>
            <Color x:Key="HavenDangerColor">#EF4444</Color>
            <Color x:Key="HavenAccentTintColor">#33EA580C</Color>
            <Color x:Key="HavenVioletTintColor">#338B5CF6</Color>
            <Color x:Key="HavenOrangeTintColor">#33EA580C</Color>
            <Color x:Key="HavenSuccessTintColor">#3322C55E</Color>
            <Color x:Key="HavenWarningTintColor">#33F59E0B</Color>
            <Color x:Key="HavenDangerTintColor">#33EF4444</Color>
            <Color x:Key="HavenFocusRingColor">#99EA580C</Color>
            <Color x:Key="HavenPermissionGlowColor">#667C3AED</Color>

            <!-- Data-visualization categorical series (spec 37): fixed hue
                 order, validated for CVD-safe adjacent separation and contrast
                 via the dataviz skill's validator (both appearances share the
                 same eight hexes; the OKLCH bands overlap enough that one set
                 clears both modes' checks). Heat ramp reuses the fixed status
                 tints (page 37: status colors never follow the theme). -->
            <Color x:Key="Series1Color">#EA580C</Color>
            <Color x:Key="Series2Color">#6D28D9</Color>
            <Color x:Key="Series3Color">#0891B2</Color>
            <Color x:Key="Series4Color">#D97706</Color>
            <Color x:Key="Series5Color">#D946EF</Color>
            <Color x:Key="Series6Color">#4D7C0F</Color>
            <Color x:Key="Series7Color">#F43F5E</Color>
            <Color x:Key="Series8Color">#0D9488</Color>

            <LinearGradientBrush x:Key="HavenCanvasGradient" StartPoint="0,0" EndPoint="0.15,1">
                <GradientStop Color="#F4ECE6" Offset="0" />
                <GradientStop Color="#FBF7F4" Offset="0.55" />
                <GradientStop Color="#FDFAF8" Offset="0.82" />
                <GradientStop Color="#F2E7DE" Offset="0.95" />
                <GradientStop Color="#F0E3D8" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HavenSplashGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F4ECE6" Offset="0" />
                <GradientStop Color="#FBF7F4" Offset="0.6" />
                <GradientStop Color="#F0E1D5" Offset="0.9" />
                <GradientStop Color="#F5E9E0" Offset="1" />
            </LinearGradientBrush>
</ResourceDictionary>
