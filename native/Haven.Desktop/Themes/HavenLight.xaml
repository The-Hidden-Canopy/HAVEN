<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Haven theme, Light appearance (spec 34-39).  Flat token set:
         ThemeService swaps one merged dictionary for another live, and the
         window root's RequestedTheme flips the framework controls. -->
            <Color x:Key="HavenCanvasColor">#F5F7FB</Color>
            <Color x:Key="HavenSurface1Color">#FFFFFF</Color>
            <Color x:Key="HavenSurface2Color">#F0F3F8</Color>
            <Color x:Key="HavenTextColor">#172033</Color>
            <Color x:Key="HavenMutedTextColor">#5C6678</Color>
            <Color x:Key="HavenStrokeColor">#D8DFEA</Color>
            <Color x:Key="HavenHoverColor">#14000000</Color>

            <Color x:Key="HavenAccentColor">#2563EB</Color>
            <Color x:Key="HavenAccentHoverColor">#1D4FD7</Color>
            <Color x:Key="HavenVioletColor">#7C3AED</Color>
            <Color x:Key="HavenOrangeColor">#EA580C</Color>
            <Color x:Key="HavenSuccessColor">#22C55E</Color>
            <Color x:Key="HavenWarningColor">#F59E0B</Color>
            <Color x:Key="HavenDangerColor">#EF4444</Color>
            <Color x:Key="HavenAccentTintColor">#332563EB</Color>
            <Color x:Key="HavenVioletTintColor">#337C3AED</Color>
            <Color x:Key="HavenOrangeTintColor">#33EA580C</Color>
            <Color x:Key="HavenSuccessTintColor">#3322C55E</Color>
            <Color x:Key="HavenWarningTintColor">#33F59E0B</Color>
            <Color x:Key="HavenDangerTintColor">#33EF4444</Color>
            <Color x:Key="HavenFocusRingColor">#992563EB</Color>
            <Color x:Key="HavenPermissionGlowColor">#667C3AED</Color>

            <!-- Data-visualization categorical series (spec 37): fixed hue
                 order, validated for CVD-safe adjacent separation and contrast
                 via the dataviz skill's validator (both appearances share the
                 same eight hexes; the OKLCH bands overlap enough that one set
                 clears both modes' checks). Heat ramp reuses the fixed status
                 tints (page 37: status colors never follow the theme). -->
            <Color x:Key="Series1Color">#3B82F6</Color>
            <Color x:Key="Series2Color">#EA580C</Color>
            <Color x:Key="Series3Color">#0284C7</Color>
            <Color x:Key="Series4Color">#D97706</Color>
            <Color x:Key="Series5Color">#D946EF</Color>
            <Color x:Key="Series6Color">#65A30D</Color>
            <Color x:Key="Series7Color">#8B5CF6</Color>
            <Color x:Key="Series8Color">#DC2626</Color>

            <LinearGradientBrush x:Key="HavenCanvasGradient" StartPoint="0,0" EndPoint="0.15,1">
                <GradientStop Color="#EDF1F8" Offset="0" />
                <GradientStop Color="#F5F7FB" Offset="0.55" />
                <GradientStop Color="#F8FAFD" Offset="0.82" />
                <GradientStop Color="#E9F0F6" Offset="0.95" />
                <GradientStop Color="#E4ECF7" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HavenSplashGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EDF1F8" Offset="0" />
                <GradientStop Color="#F5F7FB" Offset="0.6" />
                <GradientStop Color="#E7EEF9" Offset="0.9" />
                <GradientStop Color="#F3ECE6" Offset="1" />
            </LinearGradientBrush>
</ResourceDictionary>
