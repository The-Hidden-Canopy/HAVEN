<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canopy theme, Dark appearance (spec 34-39).  Flat token set:
         ThemeService swaps one merged dictionary for another live, and the
         window root's RequestedTheme flips the framework controls. -->
            <Color x:Key="HavenCanvasColor">#081716</Color>
            <Color x:Key="HavenSurface1Color">#102421</Color>
            <Color x:Key="HavenSurface2Color">#17302C</Color>
            <Color x:Key="HavenTextColor">#EFFCF8</Color>
            <Color x:Key="HavenMutedTextColor">#84A89F</Color>
            <Color x:Key="HavenStrokeColor">#294A43</Color>
            <Color x:Key="HavenHoverColor">#22FFFFFF</Color>

            <Color x:Key="HavenAccentColor">#2DD4BF</Color>
            <Color x:Key="HavenAccentHoverColor">#5EE0D1</Color>
            <Color x:Key="HavenVioletColor">#60A5FA</Color>
            <Color x:Key="HavenOrangeColor">#FB923C</Color>
            <Color x:Key="HavenSuccessColor">#22C55E</Color>
            <Color x:Key="HavenWarningColor">#F59E0B</Color>
            <Color x:Key="HavenDangerColor">#EF4444</Color>
            <Color x:Key="HavenAccentTintColor">#332DD4BF</Color>
            <Color x:Key="HavenVioletTintColor">#3360A5FA</Color>
            <Color x:Key="HavenOrangeTintColor">#33FB923C</Color>
            <Color x:Key="HavenSuccessTintColor">#3322C55E</Color>
            <Color x:Key="HavenWarningTintColor">#33F59E0B</Color>
            <Color x:Key="HavenDangerTintColor">#33EF4444</Color>
            <Color x:Key="HavenFocusRingColor">#992DD4BF</Color>
            <Color x:Key="HavenPermissionGlowColor">#408B5CF6</Color>

            <!-- Data-visualization categorical series (spec 37): fixed hue
                 order, validated for CVD-safe adjacent separation and contrast
                 via the dataviz skill's validator (both appearances share the
                 same eight hexes; the OKLCH bands overlap enough that one set
                 clears both modes' checks). Heat ramp reuses the fixed status
                 tints (page 37: status colors never follow the theme). -->
            <Color x:Key="Series1Color">#0D9488</Color>
            <Color x:Key="Series2Color">#EA580C</Color>
            <Color x:Key="Series3Color">#0284C7</Color>
            <Color x:Key="Series4Color">#D97706</Color>
            <Color x:Key="Series5Color">#D946EF</Color>
            <Color x:Key="Series6Color">#16A34A</Color>
            <Color x:Key="Series7Color">#3B82F6</Color>
            <Color x:Key="Series8Color">#F43F5E</Color>

            <LinearGradientBrush x:Key="HavenCanvasGradient" StartPoint="0,0" EndPoint="0.15,1">
                <GradientStop Color="#061211" Offset="0" />
                <GradientStop Color="#081716" Offset="0.55" />
                <GradientStop Color="#0B2320" Offset="0.82" />
                <GradientStop Color="#0F2E28" Offset="0.95" />
                <GradientStop Color="#14382F" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HavenSplashGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#061211" Offset="0" />
                <GradientStop Color="#081716" Offset="0.6" />
                <GradientStop Color="#0F2E28" Offset="0.9" />
                <GradientStop Color="#123B32" Offset="1" />
            </LinearGradientBrush>
</ResourceDictionary>
