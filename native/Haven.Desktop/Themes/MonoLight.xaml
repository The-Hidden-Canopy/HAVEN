<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Mono theme, Light appearance (spec 34-39).  Flat token set:
         ThemeService swaps one merged dictionary for another live, and the
         window root's RequestedTheme flips the framework controls. -->
            <Color x:Key="HavenCanvasColor">#F7F8FA</Color>
            <Color x:Key="HavenSurface1Color">#FFFFFF</Color>
            <Color x:Key="HavenSurface2Color">#EEF0F3</Color>
            <Color x:Key="HavenTextColor">#17191C</Color>
            <Color x:Key="HavenMutedTextColor">#5A6068</Color>
            <Color x:Key="HavenStrokeColor">#D9DDE3</Color>
            <Color x:Key="HavenHoverColor">#14000000</Color>

            <Color x:Key="HavenAccentColor">#1F2329</Color>
            <Color x:Key="HavenAccentHoverColor">#000000</Color>
            <Color x:Key="HavenVioletColor">#2563EB</Color>
            <Color x:Key="HavenOrangeColor">#4B5563</Color>
            <Color x:Key="HavenSuccessColor">#22C55E</Color>
            <Color x:Key="HavenWarningColor">#F59E0B</Color>
            <Color x:Key="HavenDangerColor">#EF4444</Color>
            <Color x:Key="HavenAccentTintColor">#331F2329</Color>
            <Color x:Key="HavenVioletTintColor">#332563EB</Color>
            <Color x:Key="HavenOrangeTintColor">#334B5563</Color>
            <Color x:Key="HavenSuccessTintColor">#3322C55E</Color>
            <Color x:Key="HavenWarningTintColor">#33F59E0B</Color>
            <Color x:Key="HavenDangerTintColor">#33EF4444</Color>
            <Color x:Key="HavenFocusRingColor">#991F2329</Color>
            <Color x:Key="HavenPermissionGlowColor">#667C3AED</Color>

            <LinearGradientBrush x:Key="HavenCanvasGradient" StartPoint="0,0" EndPoint="0.15,1">
                <GradientStop Color="#EFF1F4" Offset="0" />
                <GradientStop Color="#F7F8FA" Offset="0.55" />
                <GradientStop Color="#FCFDFE" Offset="0.82" />
                <GradientStop Color="#E9ECF0" Offset="0.95" />
                <GradientStop Color="#E4E8ED" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HavenSplashGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EFF1F4" Offset="0" />
                <GradientStop Color="#F7F8FA" Offset="0.6" />
                <GradientStop Color="#E5E8EC" Offset="0.9" />
                <GradientStop Color="#EBEEF2" Offset="1" />
            </LinearGradientBrush>
</ResourceDictionary>
