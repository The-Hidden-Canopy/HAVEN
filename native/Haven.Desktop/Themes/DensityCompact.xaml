<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compact density (spec 40): tighter rows for nav/lists/cards/buttons.
         Every key mirrors DensityComfortable.xaml's set - keep them in sync. -->
    <x:Double x:Key="DensityNavItemHeight">30</x:Double>
    <Thickness x:Key="DensityNavItemMargin">8,0,8,0</Thickness>
    <Thickness x:Key="DensityNavItemPadding">10,0,10,0</Thickness>
    <x:Double x:Key="DensityListItemMinHeight">32</x:Double>
    <Thickness x:Key="DensityListItemMargin">1,0,1,0</Thickness>
    <Thickness x:Key="DensityListItemPadding">8,2,8,2</Thickness>
    <Thickness x:Key="DensityCardPadding">10,10,10,10</Thickness>
    <x:Double x:Key="DensityButtonMinHeight">28</x:Double>
    <Thickness x:Key="DensityButtonPadding">10,3,10,3</Thickness>
    <Thickness x:Key="DensityPrimaryButtonPadding">11,3,11,3</Thickness>
    <x:Double x:Key="DensityTabButtonMinHeight">28</x:Double>
    <Thickness x:Key="DensityTabButtonPadding">8,4,8,4</Thickness>
    <x:Double x:Key="DensityCircleButtonSize">32</x:Double>
    <CornerRadius x:Key="DensityCircleButtonRadius">16</CornerRadius>
</ResourceDictionary>
