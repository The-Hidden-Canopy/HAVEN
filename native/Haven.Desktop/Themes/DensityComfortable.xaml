<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Comfortable density (spec 40, default): the sizes every Haven* style
         in App.xaml already shipped with before the density pass. Swapped
         live by ThemeService.Apply alongside the color theme dictionary. -->
    <x:Double x:Key="DensityNavItemHeight">38</x:Double>
    <Thickness x:Key="DensityNavItemMargin">10,1,10,1</Thickness>
    <Thickness x:Key="DensityNavItemPadding">12,0,12,0</Thickness>
    <x:Double x:Key="DensityListItemMinHeight">40</x:Double>
    <Thickness x:Key="DensityListItemMargin">2,1,2,1</Thickness>
    <Thickness x:Key="DensityListItemPadding">10,4,10,4</Thickness>
    <Thickness x:Key="DensityCardPadding">14,14,14,14</Thickness>
    <x:Double x:Key="DensityButtonMinHeight">32</x:Double>
    <Thickness x:Key="DensityButtonPadding">12,5,12,5</Thickness>
    <Thickness x:Key="DensityPrimaryButtonPadding">14,5,14,5</Thickness>
    <x:Double x:Key="DensityTabButtonMinHeight">34</x:Double>
    <Thickness x:Key="DensityTabButtonPadding">10,6,10,6</Thickness>
</ResourceDictionary>
