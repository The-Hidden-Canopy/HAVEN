<Window
    x:Class="Haven.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:setup="using:Haven.Desktop.Setup"
    mc:Ignorable="d"
    Title="HAVEN">
    <Grid x:Name="Root" Background="{StaticResource HavenCanvasGradient}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Title-bar drag region (caption buttons remain system-drawn). -->
        <Grid x:Name="DragStrip" Grid.ColumnSpan="3" Background="Transparent" />

        <!-- Navigation rail (spec 08): wordmark top, life domains, system
             items, profile row at the bottom. -->
        <Grid Grid.RowSpan="3" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image x:Name="LogoImage" Height="96" Stretch="Uniform"
                   HorizontalAlignment="Left" Margin="16,0,0,2" />
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NavItems" Margin="0,6,0,0">
                    <Button Tag="today" Click="OnNavItemClicked" Style="{StaticResource HavenNavItemStyle}"
                            AutomationProperties.Name="Today">

                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon Symbol="Calendar" />
                            <TextBlock Text="Today" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="search" Click="OnNavItemClicked" Style="{StaticResource HavenNavItemStyle}"
                            AutomationProperties.Name="Search">

                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon Symbol="Find" />
                            <TextBlock Text="Search" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="projects" Click="OnNavItemClicked" Style="{StaticResource HavenNavItemStyle}"
                            AutomationProperties.Name="Projects">

                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon Symbol="Folder" />
                            <TextBlock Text="Projects" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="tasks" Click="OnNavItemClicked" Style="{StaticResource HavenNavItemStyle}"
                            AutomationProperties.Name="Tasks">

                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon Symbol="List" />
                            <TextBlock Text="Tasks" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="people" Click="OnNavItemClicked" Style="{StaticResource HavenNavItemStyle}"
                            AutomationProperties.Name="People">

                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon Symbol="People" />
                            <TextBlock Text="People" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="memory" Click="OnNavItemClicked" Style="{StaticResource HavenNavItemStyle}"
                            AutomationProperties.Name="Memory">

                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon Symbol="Memo" />
                            <TextBlock Text="Memory" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="computer" Click="OnNavItemClicked" Style="{StaticResource HavenNavItemStyle}"
                            AutomationProperties.Name="Computer">

                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <FontIcon Glyph="&#xE977;" />
                            <TextBlock Text="Computer" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="communications" Click="OnNavItemClicked" Style="{StaticResource HavenNavItemStyle}"
                            AutomationProperties.Name="Communications">

                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon Symbol="Mail" />
                            <TextBlock Text="Communications" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Rectangle Height="1" Fill="{ThemeResource HavenStrokeBrush}" Margin="16,8" />

                    <Button Tag="home" Click="OnNavItemClicked" Style="{StaticResource HavenNavItemStyle}"
                            AutomationProperties.Name="Home">

                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon Symbol="Home" />
                            <TextBlock Text="Home" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="models" Click="OnNavItemClicked" Style="{StaticResource HavenNavItemStyle}"
                            AutomationProperties.Name="Models">

                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <FontIcon Glyph="&#xE753;" />
                            <TextBlock Text="Models" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Tag="settings" Click="OnNavItemClicked" Style="{StaticResource HavenNavItemStyle}"
                            AutomationProperties.Name="Settings">

                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <SymbolIcon Symbol="Setting" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="16,8,16,12" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{ThemeResource HavenAccentTintBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="P" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{ThemeResource HavenAccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="ProfileText" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Personal" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource HavenTextBrush}" />
                            <!-- Shell-level Needs You badge (spec 8.3): visible from
                                 every page, zero count removes it entirely, warning
                                 (not accent) color, never animated. -->
                            <Border x:Name="ShellNeedsYouBadge" CornerRadius="8" Padding="6,0" MinWidth="16"
                                    Background="{ThemeResource HavenWarningTintBrush}" Visibility="Collapsed"
                                    AutomationProperties.Name="Needs You count">
                                <TextBlock x:Name="ShellNeedsYouBadgeText" FontSize="10.5" HorizontalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="{ThemeResource HavenWarningBrush}" />
                            </Border>
                        </StackPanel>
                        <Button x:Name="ConnectionCenterButton" Click="OnConnectionCenterClicked"
                                Style="{StaticResource HavenQuietButtonStyle}"
                                Padding="0" MinHeight="0" HorizontalContentAlignment="Left"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="ConnectionText" Text="Connecting…" FontSize="11"
                                       Foreground="{ThemeResource HavenMutedTextBrush}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Button x:Name="ReopenSetupButton" Content="Setup &amp; connections" Click="OnReopenSetupClicked"
                        Visibility="Collapsed" HorizontalAlignment="Stretch"
                        Style="{StaticResource HavenQuietButtonStyle}" />
            </StackPanel>
        </Grid>

        <Rectangle Grid.Column="1" Grid.RowSpan="3" Width="1" Margin="0,10"
                   Fill="{ThemeResource HavenStrokeBrush}" />

        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="ConnectionBanner" Grid.Row="0" Visibility="Collapsed"
                    Background="{ThemeResource HavenWarningTintBrush}"
                    BorderBrush="{ThemeResource HavenWarningBrush}" BorderThickness="0,0,0,1"
                    Padding="30,8">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="ConnectionBannerText" VerticalAlignment="Center"
                               Style="{StaticResource HavenBodyTextStyle}"
                               Foreground="{ThemeResource HavenTextBrush}"
                               TextWrapping="Wrap" />
                    <Button x:Name="ConnectionBannerRetry" Content="Retry now" Click="OnConnectionRetryClicked" />
                </StackPanel>
            </Border>
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="30,16,30,24">
            <StackPanel MaxWidth="1120" Spacing="16">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="PageTitle" Style="{StaticResource HavenPageTitleTextStyle}" Text="Today" />
                    <TextBlock x:Name="PageDescription" Style="{StaticResource HavenMetadataTextStyle}" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Today (Needs You spec 11-16): image-backed temporal hero.
                     The daypart image is decorative (spec 21.2 - the
                     greeting/date already convey time context), so the
                     AutomationProperties.Name lives on the hero border, not
                     the image. High contrast swaps to a flat themed surface
                     (spec 21.1) via TodayHeroFlatBackground. -->
                <StackPanel x:Name="TodayPanel" Spacing="16">
                    <Border x:Name="TodayHero" Style="{StaticResource HavenCardStyle}"
                            Padding="0" MinHeight="210" MaxHeight="300"
                            AutomationProperties.Name="Today overview">
                        <Grid>
                            <Border x:Name="TodayHeroFlatBackground" Background="{ThemeResource HavenSurface2Brush}"
                                    Visibility="Collapsed" />
                            <Image x:Name="TodayHeroImage" Stretch="UniformToFill" />
                            <Rectangle Fill="{ThemeResource HavenHeroOverlayBrush}" />
                            <!-- Quick actions and the Needs You count now live
                                 in the hero itself (spec 16.3/16.2) - the hero
                                 is the home page's launch point, not a banner
                                 above separate sections. -->
                            <Grid Padding="24" ColumnSpacing="16" RowSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Spacing="6" VerticalAlignment="Center" MaxWidth="640">
                                    <TextBlock Text="A clear place to begin" Style="{StaticResource HavenMetadataTextStyle}"
                                               Foreground="{ThemeResource HavenHeroForegroundBrush}" Opacity="0.85" />
                                    <TextBlock x:Name="TodayGreeting" Style="{StaticResource HavenDisplayTextStyle}" Text="Welcome"
                                               Foreground="{ThemeResource HavenHeroForegroundBrush}" />
                                    <TextBlock x:Name="TodayDate" Style="{StaticResource HavenBodyTextStyle}"
                                               Foreground="{ThemeResource HavenHeroForegroundBrush}" />
                                    <TextBlock x:Name="TodayHeroContext" Text="Your most important signals, in one calm view."
                                               Style="{StaticResource HavenMetadataTextStyle}" TextWrapping="Wrap"
                                               Foreground="{ThemeResource HavenHeroForegroundBrush}" Opacity="0.85" />
                                </StackPanel>
                                <!-- Needs You count (spec 16.2): far right,
                                     only when count > 0 (spec 5.2 - never a
                                     zero badge); opens the same review pane
                                     as "Review all" / the pending banner. -->
                                <Button Grid.Row="0" Grid.Column="1" x:Name="HeroNeedsYouButton"
                                        Click="OnNeedsYouReviewAllClicked" VerticalAlignment="Top"
                                        Visibility="Collapsed" Background="{ThemeResource HavenWarningTintBrush}"
                                        BorderThickness="0" CornerRadius="10" Padding="10,6"
                                        AutomationProperties.Name="Needs You count">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock x:Name="HeroNeedsYouCountText" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource HavenWarningBrush}" />
                                        <TextBlock Text="Needs You" Foreground="{ThemeResource HavenWarningBrush}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel x:Name="TodayHeroActions" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" Spacing="6">
                                    <Button Click="OnQuickActionTaskClicked" Background="#26FFFFFF" BorderThickness="0" Padding="10,7" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Accept" Foreground="{ThemeResource HavenHeroForegroundBrush}" />
                                            <TextBlock Text="New task" FontSize="12.5" Foreground="{ThemeResource HavenHeroForegroundBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnQuickActionProjectClicked" Background="#26FFFFFF" BorderThickness="0" Padding="10,7" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Folder" Foreground="{ThemeResource HavenHeroForegroundBrush}" />
                                            <TextBlock Text="New project" FontSize="12.5" Foreground="{ThemeResource HavenHeroForegroundBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnQuickActionNoteClicked" Background="#26FFFFFF" BorderThickness="0" Padding="10,7" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Memo" Foreground="{ThemeResource HavenHeroForegroundBrush}" />
                                            <TextBlock Text="Note" FontSize="12.5" Foreground="{ThemeResource HavenHeroForegroundBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnQuickActionFindClicked" Background="#26FFFFFF" BorderThickness="0" Padding="10,7" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Find" Foreground="{ThemeResource HavenHeroForegroundBrush}" />
                                            <TextBlock Text="Find" FontSize="12.5" Foreground="{ThemeResource HavenHeroForegroundBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnQuickActionOpenClicked" Background="#26FFFFFF" BorderThickness="0" Padding="10,7" CornerRadius="8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="World" Foreground="{ThemeResource HavenHeroForegroundBrush}" />
                                            <TextBlock Text="Open" FontSize="12.5" Foreground="{ThemeResource HavenHeroForegroundBrush}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border x:Name="TodayPendingBanner" Style="{StaticResource HavenCardStyle}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock x:Name="TodayPendingText" VerticalAlignment="Center" Style="{StaticResource HavenBodyTextStyle}" />
                            <Button x:Name="TodayPendingButton" Content="Review" Click="OnTodayPendingClicked" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TodayStatus" Style="{StaticResource HavenMetadataTextStyle}" />

                    <!-- Dense dashboard grid (Needs You spec 17): Focus beside
                         Needs You (the two questions "what should I do" and
                         "what is waiting on me"), Tasks beside Upcoming,
                         Recent files beside Recent activity, Pending replies
                         full-width beneath and only when evidence exists.
                         Each region is a named host StackPanel inside a
                         collapsible card - empty regions collapse rather
                         than leaving a dead rectangle (see LoadTodaySnapshotAsync). -->
                    <Grid x:Name="TodayGrid" ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="TodayFocusCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource HavenCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Focus" Style="{StaticResource HavenSectionTextStyle}" />
                                <StackPanel x:Name="TodayFocusHost" Spacing="8" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="TodayNeedsYouCard" Grid.Row="0" Grid.Column="1" Style="{StaticResource HavenCardStyle}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Needs You" Style="{StaticResource HavenSectionTextStyle}" />
                                    <Border x:Name="TodayNeedsYouCountChip" CornerRadius="10" Padding="7,1"
                                            Background="{ThemeResource HavenWarningTintBrush}" Visibility="Collapsed">
                                        <TextBlock x:Name="TodayNeedsYouCountText" FontSize="11.5"
                                                   FontWeight="SemiBold" Foreground="{ThemeResource HavenWarningBrush}" />
                                    </Border>
                                    <Button x:Name="TodayNeedsYouReviewAllButton" Content="Review all"
                                            Click="OnNeedsYouReviewAllClicked" Style="{StaticResource HavenQuietButtonStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="TodayNeedsYouHost" Spacing="8" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="TodayTasksCard" Grid.Row="1" Grid.Column="0" Style="{StaticResource HavenCardStyle}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Tasks" Style="{StaticResource HavenSectionTextStyle}" />
                                    <Button Content="See all" Click="OnQuickActionTaskClicked" Style="{StaticResource HavenQuietButtonStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="TodayTasksHost" Spacing="6" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="TodayUpcomingCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource HavenCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Upcoming" Style="{StaticResource HavenSectionTextStyle}" />
                                <StackPanel x:Name="TodayUpcomingHost" Spacing="8" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="TodayFilesCard" Grid.Row="2" Grid.Column="0" Style="{StaticResource HavenCardStyle}">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Recent files" Style="{StaticResource HavenSectionTextStyle}" />
                                    <Button Content="See all" Click="OnQuickActionOpenClicked" Style="{StaticResource HavenQuietButtonStyle}" />
                                </StackPanel>
                                <StackPanel x:Name="TodayFilesHost" Spacing="6" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="TodayActivityCard" Grid.Row="2" Grid.Column="1" Style="{StaticResource HavenCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Recent activity" Style="{StaticResource HavenSectionTextStyle}" />
                                <StackPanel x:Name="TodayActivityHost" Spacing="6" />
                            </StackPanel>
                        </Border>

                        <!-- Collapsed by default (spec Appendix C): shown only
                             when the `replies` region reports a connected
                             evidence source, never to advertise the missing
                             capability. -->
                        <Border x:Name="TodayRepliesCard" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                Style="{StaticResource HavenCardStyle}" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Pending replies" Style="{StaticResource HavenSectionTextStyle}" />
                                <StackPanel x:Name="TodayRepliesHost" Spacing="6" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="TodayEmptyCard" Style="{StaticResource HavenCardStyle}" Visibility="Collapsed">
                        <TextBlock Text="Nothing needs you right now. Tasks with due dates, pending decisions, and upcoming commitments will appear here."
                                   TextWrapping="Wrap" Style="{StaticResource HavenBodyTextStyle}" />
                    </Border>
                </StackPanel>

                <!-- Search (spec 22): result list + inspector, like a native
                     command/research surface, instead of a bare result list. -->
                <StackPanel x:Name="SearchPanel" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" PlaceholderText="Files, claims, anything HAVEN can see…"
                                 KeyDown="OnSearchKeyDown" MinHeight="38" />
                        <Button Grid.Column="1" Content="Find" Click="OnSearchClicked" Style="{StaticResource HavenPrimaryButtonStyle}" />
                    </Grid>
                    <!-- Type filters map to SearchQuery.resource_types; only
                         types the backend actually indexes as resources are
                         offered (no "People" chip - people aren't indexed
                         resources, so filtering on it would silently return
                         nothing while claiming to filter - "no false
                         capability", spec 06). -->
                    <StackPanel x:Name="SearchTypeFilters" Orientation="Horizontal" Spacing="4">
                        <Button Content="All" Tag="" Click="OnSearchTypeFilterClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Files" Tag="file,folder" Click="OnSearchTypeFilterClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Messages" Tag="email_message" Click="OnSearchTypeFilterClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Calendar" Tag="calendar_event" Click="OnSearchTypeFilterClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Tasks" Tag="task" Click="OnSearchTypeFilterClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Projects" Tag="project" Click="OnSearchTypeFilterClicked" Style="{StaticResource HavenTabButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="SearchStatusText" Style="{StaticResource HavenMetadataTextStyle}" />
                    <Grid x:Name="SearchSplit" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ListView x:Name="SearchResults" SelectionChanged="OnSearchResultSelectionChanged" MaxHeight="560"
                                  ItemContainerStyle="{StaticResource HavenListItemStyle}" />
                        <Border x:Name="SearchInspector" Grid.Column="1" Style="{StaticResource HavenCardStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <Button x:Name="SearchBackButton" Content="Back to results" Click="OnSearchBackClicked"
                                        Visibility="Collapsed" Style="{StaticResource HavenSecondaryButtonStyle}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                                    <StackPanel x:Name="SearchDetail" Spacing="10">
                                        <TextBlock Text="Search, then select a result to see why it matched." TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Projects (spec 27): filter chips + card gallery + detail. -->
                <StackPanel x:Name="ProjectsPanel" Spacing="12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="All" Tag="" Click="OnProjectFilterClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Active" Tag="active" Click="OnProjectFilterClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Planning" Tag="planning" Click="OnProjectFilterClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="On hold" Tag="on_hold" Click="OnProjectFilterClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Completed" Tag="completed" Click="OnProjectFilterClicked" Style="{StaticResource HavenTabButtonStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="New project" Click="OnNewProjectClicked" Style="{StaticResource HavenPrimaryButtonStyle}" />
                        <Button Content="Refresh" Click="OnProjectsRefreshClicked" Style="{StaticResource HavenSecondaryButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="ProjectsErrorText" TextWrapping="Wrap" Foreground="{ThemeResource HavenDangerBrush}" />
                    <TextBlock x:Name="ProjectsStatusText" Style="{StaticResource HavenMetadataTextStyle}" />
                    <ListView x:Name="ProjectGallery" SelectionChanged="OnProjectSelected" MaxHeight="560"
                              ItemContainerStyle="{StaticResource HavenListItemStyle}">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                    </ListView>
                    <!-- Project detail (spec 24): 70/30 - tabs change the
                         primary work area while Progress/Files/People/
                         Blocked stay visible in the context rail. -->
                    <Grid x:Name="ProjectDetailHost" ColumnSpacing="18" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="ProjectDetailMain" Spacing="12" />
                        <Border x:Name="ProjectContextRailCard" Grid.Column="1" Style="{StaticResource HavenCardStyle}" VerticalAlignment="Top">
                            <StackPanel x:Name="ProjectContextRail" Spacing="14" />
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Tasks (spec 29): view chips, fast add, dense rows. -->
                <StackPanel x:Name="TasksPanel" Spacing="12" Visibility="Collapsed">
                    <StackPanel x:Name="TaskViews" Orientation="Horizontal" Spacing="4">
                        <Button Content="Today" Tag="today" Click="OnTaskViewClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Upcoming" Tag="upcoming" Click="OnTaskViewClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Someday" Tag="someday" Click="OnTaskViewClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Completed" Tag="completed" Click="OnTaskViewClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Refresh" Click="OnTasksRefreshClicked" Style="{StaticResource HavenSecondaryButtonStyle}" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TaskFastAddBox" PlaceholderText="Add a task…" KeyDown="OnTaskFastAddKeyDown" MinHeight="36" />
                        <Button Grid.Column="1" Content="Add task" Click="OnTaskFastAddClicked" Style="{StaticResource HavenPrimaryButtonStyle}" />
                    </Grid>
                    <TextBlock x:Name="TasksErrorText" TextWrapping="Wrap" Foreground="{ThemeResource HavenDangerBrush}" />
                    <TextBlock x:Name="TasksStatusText" Style="{StaticResource HavenMetadataTextStyle}" />
                    <!-- Aligned table header (spec 25): checkbox / task / project /
                         priority / due, matching MakeTaskRow's column widths exactly
                         so header and rows stay pixel-aligned. -->
                    <Grid ColumnSpacing="10" Padding="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Task" Style="{StaticResource HavenMetadataTextStyle}" />
                        <TextBlock Grid.Column="2" Text="Project" Style="{StaticResource HavenMetadataTextStyle}" />
                        <TextBlock Grid.Column="3" Text="Priority" Style="{StaticResource HavenMetadataTextStyle}" />
                        <TextBlock Grid.Column="4" Text="Due" Style="{StaticResource HavenMetadataTextStyle}" />
                    </Grid>
                    <StackPanel x:Name="TasksListPanel" Spacing="2" />
                </StackPanel>

                <!-- Computer (spec 28/33/34): Files gets a locations + table +
                     inspector explorer layout; Applications/Windows/Activity
                     keep the shared list host (already reasonably table/list-
                     like per page). -->
                <StackPanel x:Name="ComputerPanel" Spacing="12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Files" Tag="files" Click="OnComputerTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Applications" Tag="apps" Click="OnComputerTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Windows" Tag="windows" Click="OnComputerTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Activity" Tag="activity" Click="OnComputerTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Refresh" Click="OnComputerRefreshClicked" Style="{StaticResource HavenSecondaryButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="ComputerErrorText" TextWrapping="Wrap" Foreground="{ThemeResource HavenDangerBrush}" />
                    <TextBlock x:Name="ComputerStatusText" Style="{StaticResource HavenMetadataTextStyle}" />

                    <Grid x:Name="ComputerFilesGrid" ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>
                        <!-- Locations: real folders derived from observed files
                             (not a fabricated filesystem tree - HAVEN has no
                             browse-arbitrary-folders capability). -->
                        <ListView x:Name="ComputerLocations" SelectionChanged="OnComputerLocationSelectionChanged" MaxHeight="480"
                                  ItemContainerStyle="{StaticResource HavenListItemStyle}" />
                        <ListView x:Name="ComputerFilesTable" Grid.Column="1" SelectionChanged="OnComputerFileSelectionChanged" MaxHeight="480"
                                  ItemContainerStyle="{StaticResource HavenListItemStyle}" />
                        <Border x:Name="ComputerFileInspector" Grid.Column="2" Style="{StaticResource HavenCardStyle}" Padding="16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                                <StackPanel x:Name="ComputerFileDetail" Spacing="10">
                                    <TextBlock Text="Select a file to see why HAVEN has it and what you can do." TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="ComputerTabContent" Spacing="8" />
                </StackPanel>

                <!-- Communications (spec 29): Email gets an account/list/
                     content split; Calendar gets a real week canvas + event
                     inspector. Messages/Browser tabs keep the shared list
                     host - Messages has no connected provider to show a list
                     for, and Browser tabs' window/session grouping is left
                     for a future pass. -->
                <StackPanel x:Name="CommunicationsPanel" Spacing="14" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="Email" Tag="email" Click="OnCommsTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Messages" Tag="messages" Click="OnCommsTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Calendar" Tag="calendar" Click="OnCommsTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Browser tabs" Tag="browser" Click="OnCommsTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Refresh" Click="OnCommsRefreshClicked" Style="{StaticResource HavenSecondaryButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="CommsErrorText" TextWrapping="Wrap" Foreground="{ThemeResource HavenDangerBrush}" />
                    <TextBlock x:Name="CommsStatusText" Style="{StaticResource HavenMetadataTextStyle}" />

                    <StackPanel x:Name="CommsEmailPanel" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="EmailConnectionText" VerticalAlignment="Center" Style="{StaticResource HavenMetadataTextStyle}" />
                            <Button x:Name="EmailFolderButton" Content="Change mail folder…" Click="OnEmailFolderClicked" Style="{StaticResource HavenSecondaryButtonStyle}" />
                        </StackPanel>
                        <Grid x:Name="CommsEmailGrid" ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <ListView x:Name="EmailMessages" SelectionChanged="OnEmailMessageSelectionChanged" MaxHeight="520"
                                      ItemContainerStyle="{StaticResource HavenListItemStyle}" />
                            <Border x:Name="EmailInspector" Grid.Column="1" Style="{StaticResource HavenCardStyle}" Padding="16">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                    <StackPanel x:Name="EmailDetail" Spacing="10">
                                        <TextBlock Text="Select a message to read it." TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Calendar: week canvas (day columns, horizontally
                         scrollable) + a below inspector for the selected
                         event, rather than a flat chronological card list. -->
                    <StackPanel x:Name="CommsCalendarPanel" Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="‹" Click="OnCalendarPrevWeekClicked" Style="{StaticResource HavenSecondaryButtonStyle}" />
                            <TextBlock x:Name="CalendarWeekRangeText" VerticalAlignment="Center" Style="{StaticResource HavenMetadataTextStyle}" MinWidth="160" />
                            <Button Content="›" Click="OnCalendarNextWeekClicked" Style="{StaticResource HavenSecondaryButtonStyle}" />
                            <Button Content="Today" Click="OnCalendarTodayClicked" Style="{StaticResource HavenSecondaryButtonStyle}" />
                            <Button Content="Add .ics file…" Click="OnAddIcsClicked" Style="{StaticResource HavenSecondaryButtonStyle}" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="CalendarWeekGrid" Orientation="Horizontal" Spacing="8" />
                        </ScrollViewer>
                        <Border Style="{StaticResource HavenCardStyle}">
                            <StackPanel x:Name="CalendarEventDetail" Spacing="10">
                                <TextBlock Text="Select an event to see details." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="CommsTabContent" Spacing="8" />
                </StackPanel>

                <StackPanel x:Name="MemoryPanel" Spacing="16" Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="What HAVEN knows" />
                        <TextBlock Text="Inspect what was remembered, where it came from, and how certain it is." TextWrapping="Wrap" Style="{StaticResource HavenMetadataTextStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Tell HAVEN" Click="OnMemoryTellClicked" Style="{StaticResource HavenPrimaryButtonStyle}" />
                        <Button Content="Connect a folder" Click="OnMemoryConnectFolderClicked" Style="{StaticResource HavenSecondaryButtonStyle}" />
                        <Button Content="Refresh" Click="OnMemoryRefreshClicked" Style="{StaticResource HavenSecondaryButtonStyle}" />
                    </StackPanel>
                    <Grid x:Name="MemorySplit" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <ListView x:Name="MemoryClaims" SelectionChanged="OnMemorySelectionChanged" MaxHeight="560"
                                  ItemContainerStyle="{StaticResource HavenListItemStyle}" />
                        <Border x:Name="MemoryInspector" Grid.Column="1" Style="{StaticResource HavenCardStyle}" Padding="18">
                            <StackPanel Spacing="12">
                                <Button x:Name="MemoryBackButton" Content="Back to memories" Click="OnMemoryBackClicked"
                                        Visibility="Collapsed" Style="{StaticResource HavenSecondaryButtonStyle}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="470">
                                    <TextBlock x:Name="MemoryDetailText" Text="Select a memory to inspect its evidence." TextWrapping="Wrap" />
                                </ScrollViewer>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="MemoryCorrectButton" Content="Correct" Click="OnMemoryCorrectClicked" IsEnabled="False" />
                                    <Button x:Name="MemoryStaleButton" Content="Mark stale" Click="OnMemoryStaleClicked" IsEnabled="False" />
                                    <Button x:Name="MemoryForgetButton" Content="Forget" Click="OnMemoryForgetClicked" IsEnabled="False" Style="{StaticResource HavenDangerButtonStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="MemoryActionStatus" TextWrapping="Wrap" Style="{StaticResource HavenMetadataTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- People (spec 26): master-detail - directory left, selected
                     person's relationship context right - instead of a
                     stacked card per person. -->
                <StackPanel x:Name="PeoplePanel" Spacing="12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Add person" Click="OnAddPersonClicked"
                                Style="{StaticResource HavenPrimaryButtonStyle}" />
                        <Button Content="Refresh" Click="OnPeopleRefreshClicked"
                                Style="{StaticResource HavenSecondaryButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="PeopleErrorText" TextWrapping="Wrap" Foreground="{ThemeResource HavenDangerBrush}" />
                    <TextBlock x:Name="PeopleStatusText" Style="{StaticResource HavenMetadataTextStyle}" />
                    <Grid x:Name="PeopleSplit" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>
                        <ListView x:Name="PeopleDirectory" SelectionChanged="OnPersonSelectionChanged" MaxHeight="560"
                                  ItemContainerStyle="{StaticResource HavenListItemStyle}" />
                        <Border x:Name="PersonInspector" Grid.Column="1" Style="{StaticResource HavenCardStyle}" Padding="18">
                            <StackPanel Spacing="10">
                                <Button x:Name="PersonBackButton" Content="Back to people" Click="OnPersonBackClicked"
                                        Visibility="Collapsed" Style="{StaticResource HavenSecondaryButtonStyle}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                                    <StackPanel x:Name="PersonDetail" Spacing="10">
                                        <TextBlock Text="Select a person to see their relationship context." TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Home (spec 36): rooms, devices, automations, contexts under top tabs. -->
                <StackPanel x:Name="HomePanel" Spacing="12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="HomeUpdatedText" VerticalAlignment="Center" Style="{StaticResource HavenMetadataTextStyle}" />
                        <Button Content="Refresh" Click="OnRoomsRefreshClicked" VerticalAlignment="Center"
                                Style="{StaticResource HavenSecondaryButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="RoomsErrorText" TextWrapping="Wrap" Foreground="{ThemeResource HavenDangerBrush}" />
                    <TextBlock x:Name="HomeStatusText" Style="{StaticResource HavenMetadataTextStyle}" />
                    <StackPanel x:Name="HomeTabs" Orientation="Horizontal" Spacing="4">
                        <Button Content="Rooms" Tag="rooms" Click="OnHomeTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Devices" Tag="devices" Click="OnHomeTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Automations" Tag="automations" Click="OnHomeTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Contexts" Tag="contexts" Click="OnHomeTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Discover" Tag="discover" Click="OnHomeTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="HomeTabRooms" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AddRoomButton" Content="Add room" Click="OnAddRoomClicked"
                                    Style="{StaticResource HavenPrimaryButtonStyle}" />
                        </StackPanel>
                        <ListView x:Name="RoomCards" SelectionChanged="OnRoomSelectionChanged" MaxHeight="300"
                                  ItemContainerStyle="{StaticResource HavenListItemStyle}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                        </ListView>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Pending confirmations" Style="{StaticResource HavenSectionTextStyle}" />
                            <StackPanel x:Name="PendingList" Spacing="6" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                            <StackPanel x:Name="RoomDetail" Spacing="10" />
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel x:Name="HomeTabDevices" Spacing="10" Visibility="Collapsed">
                        <StackPanel x:Name="HomeDevicesList" Spacing="8" />
                    </StackPanel>

                    <StackPanel x:Name="HomeTabAutomations" Spacing="12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Refresh" Click="OnAutomationsRefreshClicked"
                                    Style="{StaticResource HavenSecondaryButtonStyle}" />
                            <Button Content="Propose automation" Click="OnProposeAutomationClicked"
                                    Style="{StaticResource HavenPrimaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="AutomationsErrorText" TextWrapping="Wrap" Foreground="{ThemeResource HavenDangerBrush}" />
                        <TextBlock x:Name="AutomationsStatusText" Style="{StaticResource HavenMetadataTextStyle}" />
                        <StackPanel x:Name="AutomationsList" Spacing="8" />
                        <StackPanel x:Name="ResourceAutomationsSection" Spacing="8">
                            <TextBlock Text="Cross-domain resource automations" Style="{StaticResource HavenSectionTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add" Click="OnResourceAutomationAddClicked"
                                        Style="{StaticResource HavenPrimaryButtonStyle}" />
                                <Button Content="Refresh" Click="OnResourceAutomationsRefreshClicked"
                                        Style="{StaticResource HavenSecondaryButtonStyle}" />
                                <TextBlock x:Name="ResourceAutomationsStatusText" Style="{StaticResource HavenMetadataTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ResourceAutomationsErrorText" TextWrapping="Wrap"
                                       Foreground="{ThemeResource HavenDangerBrush}" />
                            <StackPanel x:Name="ResourceAutomationsList" Spacing="8" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="HomeTabContexts" Spacing="12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource HavenMetadataTextStyle}"
                                       Text="Contexts map a household entity's “on” to a meaning HAVEN can reason about." />
                            <Button Content="Add context" Click="OnAddContextClicked" VerticalAlignment="Center"
                                    Style="{StaticResource HavenPrimaryButtonStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="ContextsList" Spacing="8" />
                    </StackPanel>

                    <StackPanel x:Name="HomeTabDiscover" Spacing="12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource HavenMetadataTextStyle}"
                                       Text="A scan finds nearby WiFi/Bluetooth devices; enrolling one is your decision, not the scan's." />
                            <Button x:Name="DiscoveryScanButton" Content="Scan" Click="OnDiscoveryScanClicked" VerticalAlignment="Center"
                                    Style="{StaticResource HavenPrimaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="DiscoveryErrorText" TextWrapping="Wrap" Foreground="{ThemeResource HavenDangerBrush}" />
                        <TextBlock x:Name="DiscoveryStatusText" Style="{StaticResource HavenMetadataTextStyle}" />
                        <StackPanel x:Name="DiscoveryCandidatesList" Spacing="8" />
                    </StackPanel>
                </StackPanel>

                <!-- Models (spec 38): Local / Downloaded / External / Downloads. -->
                <StackPanel x:Name="ModelsPanel" Spacing="12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Refresh" Click="OnModelsRefreshClicked"
                                Style="{StaticResource HavenSecondaryButtonStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Install from URL…" Click="OnInstallFromUrlClicked" />
                        <Button Content="Install local folder…" Click="OnInstallLocalClicked" />
                        <Button Content="Add endpoint…" Click="OnAddEndpointClicked" />
                        <Button Content="Add root…" Click="OnAddModelRootClicked" />
                        <Button Content="Scan roots" Click="OnScanModelRootsClicked" />
                    </StackPanel>
                    <TextBlock x:Name="ModelsErrorText" TextWrapping="Wrap" Foreground="{ThemeResource HavenDangerBrush}" />
                    <StackPanel x:Name="ModelsTabs" Orientation="Horizontal" Spacing="4">
                        <Button Content="Local" Tag="local" Click="OnModelsTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Downloaded" Tag="downloaded" Click="OnModelsTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="External" Tag="endpoint" Click="OnModelsTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                        <Button Content="Downloads" Tag="downloads" Click="OnModelsTabClicked" Style="{StaticResource HavenTabButtonStyle}" />
                    </StackPanel>

                    <StackPanel x:Name="ModelsTabLocal" Spacing="8">
                        <StackPanel x:Name="ModelsLocalList" Spacing="8" />
                        <TextBlock x:Name="DiscoveredHeading" Text="Discovered candidates" Style="{StaticResource HavenSectionTextStyle}" Visibility="Collapsed" />
                        <StackPanel x:Name="DiscoveredList" Spacing="8" />
                    </StackPanel>
                    <StackPanel x:Name="ModelsTabDownloaded" Spacing="8" Visibility="Collapsed">
                        <StackPanel x:Name="ModelsList" Spacing="8" />
                    </StackPanel>
                    <StackPanel x:Name="ModelsTabExternal" Spacing="8" Visibility="Collapsed">
                        <StackPanel x:Name="ModelsExternalList" Spacing="8" />
                    </StackPanel>
                    <StackPanel x:Name="ModelsTabDownloads" Spacing="8" Visibility="Collapsed">
                        <StackPanel x:Name="ModelJobs" Spacing="6" />
                    </StackPanel>

                    <TextBlock Text="Role assignments" Style="{StaticResource HavenSectionTextStyle}" />
                    <StackPanel x:Name="ModelRoles" Spacing="6" />
                </StackPanel>

                <!-- Settings (spec 39): control-center categories. -->
                <StackPanel x:Name="SettingsPanel" Spacing="14" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Probe provider" Click="OnProbeProviderClicked" />
                        <Button Content="Refresh" Click="OnSettingsRefreshClicked" />
                    </StackPanel>
                    <TextBlock x:Name="SettingsErrorText" TextWrapping="Wrap" Foreground="{ThemeResource HavenDangerBrush}" />
                    <TextBlock x:Name="SettingsStatusText" Style="{StaticResource HavenMetadataTextStyle}" />

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="Appearance" />
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource HavenMetadataTextStyle}" Text="Mode" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <RadioButton x:Name="ModeSystemRadio" Content="System" GroupName="AppearanceMode" Click="OnAppearanceChanged" />
                            <RadioButton x:Name="ModeLightRadio" Content="Light" GroupName="AppearanceMode" Click="OnAppearanceChanged" />
                            <RadioButton x:Name="ModeDarkRadio" Content="Dark" GroupName="AppearanceMode" Click="OnAppearanceChanged" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource HavenMetadataTextStyle}" Text="Theme" />
                        <ComboBox x:Name="ThemePicker" SelectionChanged="OnAppearanceSelectionChanged">
                            <ComboBoxItem Content="Haven" Tag="haven" />
                            <ComboBoxItem Content="Canopy" Tag="canopy" />
                            <ComboBoxItem Content="Ember" Tag="ember" />
                            <ComboBoxItem Content="Mono" Tag="mono" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource HavenMetadataTextStyle}" Text="Density" />
                        <ComboBox x:Name="DensityPicker" SelectionChanged="OnAppearanceSelectionChanged">
                            <ComboBoxItem Content="Comfortable" Tag="comfortable" />
                            <ComboBoxItem Content="Compact" Tag="compact" />
                        </ComboBox>
                        <TextBlock Style="{StaticResource HavenMetadataTextStyle}" Text="Motion" />
                        <ComboBox x:Name="MotionPicker" SelectionChanged="OnAppearanceSelectionChanged">
                            <ComboBoxItem Content="System" Tag="system" />
                            <ComboBoxItem Content="Reduced" Tag="reduced" />
                        </ComboBox>
                    </StackPanel>
                    <Border x:Name="AppearancePreview" Style="{StaticResource HavenCardStyle}" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource HavenMetadataTextStyle}" Text="Preview" />
                            <Border x:Name="AppearancePreviewNav" Background="{ThemeResource HavenAccentBrush}"
                                    CornerRadius="8" Padding="12,0" Height="38">
                                <TextBlock Text="Navigation item" VerticalAlignment="Center" Foreground="#FFFFFF" />
                            </Border>
                            <Border Style="{StaticResource HavenCardStyle}" Padding="10">
                                <TextBlock Style="{StaticResource HavenBodyTextStyle}" Text="Card surface" />
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Background="{ThemeResource HavenAccentTintBrush}" CornerRadius="10" Padding="10,3">
                                    <TextBlock Style="{StaticResource HavenMetadataTextStyle}" Text="Chip" />
                                </Border>
                                <Button Content="Primary" Style="{StaticResource HavenPrimaryButtonStyle}" IsEnabled="False" />
                                <Button Content="Quiet" Style="{StaticResource HavenQuietButtonStyle}" IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="General" />
                    <StackPanel x:Name="ServicePanel" Spacing="8" />

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="Storage" />
                    <TextBlock x:Name="StorageDataDirText" Style="{StaticResource HavenMonoTextStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource HavenMetadataTextStyle}" Text="Backups capture every installation file; restore replaces them on disk." />
                        <Button Content="Create backup" Click="OnCreateBackupClicked" VerticalAlignment="Center"
                                Style="{StaticResource HavenPrimaryButtonStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="BackupsList" Spacing="8" />

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="Intelligence" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="IntelligenceVoiceText" VerticalAlignment="Center" Style="{StaticResource HavenMetadataTextStyle}" />
                        <Button Content="Open models" Click="OnOpenModelsClicked" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="Extensions" />
                    <TextBlock Style="{StaticResource HavenMetadataTextStyle}" TextWrapping="Wrap"
                               Text="Four extension classes, each with a declared run-location and boundary. What is listed here is described, not granted." />
                    <StackPanel x:Name="ExtensionsHost" Spacing="8" />

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="Privacy" />
                    <TextBlock Style="{StaticResource HavenMetadataTextStyle}" TextWrapping="Wrap"
                               Text="Retention, activity observation and export controls arrive with the privacy milestone. HAVEN stores everything locally today." />

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="Permissions" />
                    <TextBlock Style="{StaticResource HavenMetadataTextStyle}" TextWrapping="Wrap"
                               Text="A view of capability grants and pending authority is planned; governed actions currently surface their permission cards where they happen, and receipts live in the activity history." />

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="Connections" />
                    <TextBlock Style="{StaticResource HavenMetadataTextStyle}" TextWrapping="Wrap"
                               Text="Connect supported home providers from Setup. Email folders and calendar files connect directly from Communications, and computer folders connect directly from Computer." />
                    <Button Content="Open setup &amp; connections" Click="OnReopenSetupClicked" HorizontalAlignment="Left" />

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="External Agents" />
                    <TextBlock Style="{StaticResource HavenMetadataTextStyle}" TextWrapping="Wrap"
                               Text="Outside assistants (Alexa+, future MCP clients) can request work through a bounded connection; they never gain direct control. A connection starts disabled, and a subject only acts as a household person once you explicitly bind it here." />
                    <TextBlock x:Name="ExternalAgentsErrorText" TextWrapping="Wrap" Foreground="{ThemeResource HavenDangerBrush}" />
                    <Button Content="Add connection" Click="OnAddExternalAgentConnectionClicked" HorizontalAlignment="Left"
                            Style="{StaticResource HavenPrimaryButtonStyle}" />
                    <StackPanel x:Name="ExternalAgentsList" Spacing="8" />

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="MCP endpoint (this device)" />
                    <TextBlock Style="{StaticResource HavenMetadataTextStyle}" TextWrapping="Wrap"
                               Text="When on, this device serves POST /mcp on loopback for external clients (Alexa+). Callers authenticate with a connection's bearer credential (set when adding a connection above); a provider-asserted subject rides the X-HAVEN-Subject header and only ever acts through a binding you made. Admission and every mutation still cross HAVEN's authority engine." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch x:Name="McpEndpointToggle" OnContent="On" OffContent="Off" VerticalAlignment="Center" />
                        <TextBox x:Name="McpEndpointPort" PlaceholderText="8741" Width="110" VerticalAlignment="Center" />
                        <Button Content="Apply" Click="OnMcpEndpointApplyClicked" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="McpEndpointStatusText" Style="{StaticResource HavenMetadataTextStyle}" TextWrapping="Wrap" />

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="Notifications" />
                    <TextBlock Style="{StaticResource HavenMetadataTextStyle}" TextWrapping="Wrap"
                               Text="System notifications and quiet hours are not configurable yet; nothing is sent while HAVEN is closed." />

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="Accessibility" />
                    <TextBlock Style="{StaticResource HavenMetadataTextStyle}" TextWrapping="Wrap"
                               Text="HAVEN follows Windows text scaling, high contrast and reduced-motion settings; dedicated controls arrive later." />

                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="About" />
                    <TextBlock x:Name="AboutVersionText" Style="{StaticResource HavenMetadataTextStyle}" />
                    <TextBlock x:Name="ProbeResultText" TextWrapping="Wrap" Style="{StaticResource HavenMetadataTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="Diagnostics" VerticalAlignment="Center" />
                        <Button Content="Export diagnostics…" Click="OnExportDiagnosticsClicked" VerticalAlignment="Center"
                                ToolTipService.ToolTip="A support-safe snapshot (version, provider/model/scheduler state, recent receipts) - never secrets." />
                    </StackPanel>
                    <StackPanel x:Name="DiagnosticsList" Spacing="4" />
                    <TextBlock Style="{StaticResource HavenSectionTextStyle}" Text="Recent governed actions" />
                    <TextBlock x:Name="ReceiptsErrorText" TextWrapping="Wrap" Foreground="{ThemeResource HavenDangerBrush}" />
                    <StackPanel x:Name="ReceiptsList" Spacing="8" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!-- Persistent composer (spec 10): centered pill, mic left, circular send. -->
        <Grid Grid.Row="2" Grid.Column="2">
            <StackPanel MaxWidth="880" HorizontalAlignment="Stretch" Margin="30,10,30,16" Spacing="8">
                <StackPanel x:Name="ComposerResults" Spacing="6" Visibility="Collapsed" />
                <Border CornerRadius="24" Background="{ThemeResource HavenSurface1Brush}"
                        BorderBrush="{ThemeResource HavenStrokeBrush}" BorderThickness="1" Padding="6,5">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ComposerMicButton" Grid.Column="0" IsEnabled="False"
                                ToolTipService.ToolTip="Voice input arrives with the native speech surface."
                                AutomationProperties.Name="Voice input (not yet available)"
                                Style="{StaticResource HavenCircleButtonStyle}">
                            <SymbolIcon Symbol="Microphone" />
                        </Button>
                        <TextBox x:Name="ComposerInput" Grid.Column="1"
                                 PlaceholderText="Ask HAVEN or find anything…"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="120"
                                 VerticalAlignment="Center" KeyDown="OnComposerKeyDown"
                                 Background="Transparent" BorderThickness="0" />
                        <Button x:Name="ComposerSendButton" Grid.Column="2" Click="OnComposerSendClicked"
                                AutomationProperties.Name="Send"
                                Style="{StaticResource HavenCircleButtonStyle}"
                                Background="{ThemeResource HavenAccentBrush}" Foreground="#FFFFFF">
                            <SymbolIcon Symbol="Send" />
                        </Button>
                    </Grid>
                </Border>
                <StackPanel x:Name="ComposerThinking" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"
                            HorizontalAlignment="Center">
                    <ProgressRing Width="16" Height="16" IsActive="True" />
                    <TextBlock Text="Thinking…" Style="{StaticResource HavenMetadataTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="ComposerStatus" Style="{StaticResource HavenMetadataTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Needs You review pane (spec 8.2): a right-side overlay, not a
             modal dialog, so Today stays visible behind it. First release is
             Review-only (spec 9.2) - no inline approve/deny here; every item
             still routes to its own governed surface. -->
        <Grid x:Name="NeedsYouOverlay" Grid.RowSpan="3" Grid.ColumnSpan="3" Visibility="Collapsed"
              Background="#66000000">
            <Border HorizontalAlignment="Right" Width="400" Background="{ThemeResource HavenSurface1Brush}"
                    BorderBrush="{ThemeResource HavenStrokeBrush}" BorderThickness="1,0,0,0">
                <Grid Padding="20" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NeedsYouPaneTitle" Grid.Column="0" Text="Needs You"
                                   Style="{StaticResource HavenSectionTextStyle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Close" Click="OnNeedsYouCloseClicked"
                                Style="{StaticResource HavenQuietButtonStyle}" />
                    </Grid>
                    <TextBlock x:Name="NeedsYouPaneStatus" Grid.Row="1" Style="{StaticResource HavenMetadataTextStyle}"
                               TextWrapping="Wrap" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="NeedsYouPaneHost" Spacing="10" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="SetupOverlay" Grid.RowSpan="3" Grid.ColumnSpan="3" Visibility="Collapsed"
              Background="{StaticResource HavenCanvasGradient}">
            <setup:SetupWizardView x:Name="SetupWizard" SetupCompleted="OnSetupCompleted" />
        </Grid>

        <!-- Splash (spec 22): wordmark, statement, honest startup progress. -->
        <Grid x:Name="SplashOverlay" Grid.RowSpan="3" Grid.ColumnSpan="3"
              Background="{StaticResource HavenSplashGradient}">
            <StackPanel VerticalAlignment="Center" Spacing="12" HorizontalAlignment="Center">
                <Image x:Name="SplashLogo" Width="240" Height="80" Stretch="Uniform" />
                <TextBlock Text="Your life. Understood." Style="{StaticResource HavenDisplayTextStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="A local-first assistant for your computer, devices, and everything you do."
                           Style="{StaticResource HavenMetadataTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" />
                <ProgressBar Width="220" IsIndeterminate="True" Margin="0,16,0,0"
                             Foreground="{ThemeResource HavenAccentBrush}" />
                <TextBlock x:Name="SplashStatus" Text="Starting HAVEN…" Style="{StaticResource HavenMetadataTextStyle}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
