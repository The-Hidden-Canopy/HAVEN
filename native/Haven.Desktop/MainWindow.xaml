<Window
    x:Class="Haven.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:setup="using:Haven.Desktop.Setup"
    mc:Ignorable="d"
    Title="HAVEN">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,18" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="LogoImage" Width="144" Height="48" Stretch="Uniform" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Local assistant for your computer, information, and connected world" Opacity="0.72" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="ConnectionText" VerticalAlignment="Center" Text="Connecting…" />
                <Button x:Name="ReopenSetupButton" Content="Setup" Click="OnReopenSetupClicked" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <NavigationView Grid.Row="1" IsBackButtonVisible="Collapsed" PaneDisplayMode="LeftCompact" SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Today" Tag="today" />
                <NavigationViewItem Content="Search" Tag="search" />
                <NavigationViewItem Content="Memory" Tag="memory" />
                <NavigationViewItem Content="Rooms" Tag="rooms" />
                <NavigationViewItem Content="People" Tag="people" />
                <NavigationViewItem Content="Automations" Tag="automations" />
                <NavigationViewItem Content="Home" Tag="home" />
                <NavigationViewItem Content="Models" Tag="models" />
                <NavigationViewItem Content="Settings" Tag="settings" />
            </NavigationView.MenuItems>

            <ScrollViewer Padding="32,24">
                <StackPanel MaxWidth="980" Spacing="20">
                    <TextBlock x:Name="PageTitle" FontSize="32" FontWeight="SemiBold" Text="HAVEN" />
                    <TextBlock x:Name="PageDescription" FontSize="16" Opacity="0.72" Text="One continuous assistant across your computer and connected world." TextWrapping="Wrap" />

                    <StackPanel x:Name="SearchPanel" Spacing="12" Visibility="Collapsed">
                        <TextBox x:Name="SearchBox" PlaceholderText="Ask HAVEN or find anything…" KeyDown="OnSearchKeyDown" />
                        <Button Content="Find" Click="OnSearchClicked" HorizontalAlignment="Left" />
                        <ListView x:Name="SearchResults" SelectionMode="None" />
                    </StackPanel>

                    <StackPanel x:Name="MemoryPanel" Spacing="16" Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="20" Text="What HAVEN knows" />
                            <TextBlock Text="Inspect what was remembered, where it came from, and how certain it is." TextWrapping="Wrap" Opacity="0.72" />
                        </StackPanel>
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.2*" />
                            </Grid.ColumnDefinitions>
                            <ListView x:Name="MemoryClaims" SelectionChanged="OnMemorySelectionChanged" MaxHeight="560" />
                            <Border Grid.Column="1" Padding="18" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <StackPanel Spacing="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="470">
                                        <TextBlock x:Name="MemoryDetailText" Text="Select a memory to inspect its evidence." TextWrapping="Wrap" />
                                    </ScrollViewer>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="MemoryCorrectButton" Content="Correct" Click="OnMemoryCorrectClicked" IsEnabled="False" />
                                        <Button x:Name="MemoryStaleButton" Content="Mark stale" Click="OnMemoryStaleClicked" IsEnabled="False" />
                                        <Button x:Name="MemoryForgetButton" Content="Forget" Click="OnMemoryForgetClicked" IsEnabled="False" />
                                    </StackPanel>
                                    <TextBlock x:Name="MemoryActionStatus" TextWrapping="Wrap" Opacity="0.72" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="RoomsPanel" Spacing="12" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="20" Text="Rooms &amp; devices" />
                                <TextBlock Text="Your home, its devices, and what HAVEN last observed about them." TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh" Click="OnRoomsRefreshClicked" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="RoomsErrorText" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.8*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="10">
                                <ListView x:Name="RoomsList" SelectionChanged="OnRoomSelectionChanged" MaxHeight="380" />
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Pending confirmations" FontWeight="SemiBold" />
                                    <StackPanel x:Name="PendingList" Spacing="6" />
                                </StackPanel>
                            </StackPanel>
                            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" MaxHeight="560">
                                <StackPanel x:Name="RoomDetail" Spacing="10" />
                            </ScrollViewer>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PeoplePanel" Spacing="12" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="20" Text="People &amp; contexts" />
                                <TextBlock Text="Who lives here, how HAVEN senses their presence, and the contexts it watches." TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Add person" Click="OnAddPersonClicked" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Add context" Click="OnAddContextClicked" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="PeopleErrorText" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="People" />
                        <StackPanel x:Name="PeopleList" Spacing="8" />
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Contexts" />
                        <StackPanel x:Name="ContextsList" Spacing="8" />
                    </StackPanel>

                    <StackPanel x:Name="AutomationsPanel" Spacing="12" Visibility="Collapsed">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="20" Text="Automations" />
                                <TextBlock Text="Rules HAVEN can run on a schedule. Proposals need an owner's approval before the scheduler acts." TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Refresh" Click="OnAutomationsRefreshClicked" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Propose automation" Click="OnProposeAutomationClicked" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="AutomationsErrorText" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <StackPanel x:Name="AutomationsList" Spacing="8" />
                    </StackPanel>

                    <StackPanel x:Name="HomePanel" Spacing="12">
                        <TextBlock FontSize="20" Text="What do you want to do?" />
                        <TextBox x:Name="ComposerBox" PlaceholderText="Ask HAVEN…" KeyDown="OnComposerKeyDown" />
                        <Button Content="Ask HAVEN" Click="OnComposerClicked" HorizontalAlignment="Left" />
                        <TextBlock x:Name="ResponseText" TextWrapping="Wrap" Opacity="0.86" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>

        <Grid x:Name="SetupOverlay" Grid.RowSpan="2" Visibility="Collapsed">
            <setup:SetupWizardView x:Name="SetupWizard" SetupCompleted="OnSetupCompleted" />
        </Grid>
    </Grid>
</Window>
