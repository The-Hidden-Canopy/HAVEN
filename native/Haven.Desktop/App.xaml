<Application
    x:Class="Haven.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Flat theme dictionaries live under Themes/ and are merged
                     by App at startup, then swapped live by ThemeService. -->
            </ResourceDictionary.MergedDictionaries>

            <!-- Base brushes track the active theme dictionary (spec 34-39).
                 Semantic aliases below give pages a stable vocabulary:
                 CanvasBase/Surface*/Text*/StrokeSubtle map to the shell tokens,
                 Accent*/FocusRing/PermissionGlow to the interaction tokens,
                 Series1-8 and Heat* to the data-visualization tokens. -->
            <SolidColorBrush x:Key="HavenCanvasBrush" Color="{ThemeResource HavenCanvasColor}" />
            <SolidColorBrush x:Key="HavenSurface1Brush" Color="{ThemeResource HavenSurface1Color}" />
            <SolidColorBrush x:Key="HavenSurface2Brush" Color="{ThemeResource HavenSurface2Color}" />
            <SolidColorBrush x:Key="HavenTextBrush" Color="{ThemeResource HavenTextColor}" />
            <SolidColorBrush x:Key="HavenMutedTextBrush" Color="{ThemeResource HavenMutedTextColor}" />
            <SolidColorBrush x:Key="HavenStrokeBrush" Color="{ThemeResource HavenStrokeColor}" />
            <SolidColorBrush x:Key="HavenHoverBrush" Color="{ThemeResource HavenHoverColor}" />

            <SolidColorBrush x:Key="CanvasBaseBrush" Color="{ThemeResource HavenCanvasColor}" />
            <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{ThemeResource HavenSurface1Color}" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{ThemeResource HavenSurface2Color}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource HavenTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource HavenMutedTextColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource HavenMutedTextColor}" />
            <SolidColorBrush x:Key="StrokeSubtleBrush" Color="{ThemeResource HavenStrokeColor}" />

            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource HavenAccentColor}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource HavenAccentHoverColor}" />
            <SolidColorBrush x:Key="FocusRingBrush" Color="{ThemeResource HavenFocusRingColor}" />
            <SolidColorBrush x:Key="PermissionGlowBrush" Color="{ThemeResource HavenPermissionGlowColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{ThemeResource HavenSuccessColor}" />
            <SolidColorBrush x:Key="WarningBrush" Color="{ThemeResource HavenWarningColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource HavenDangerColor}" />
            <SolidColorBrush x:Key="SuccessTintBrush" Color="{ThemeResource HavenSuccessTintColor}" />
            <SolidColorBrush x:Key="WarningTintBrush" Color="{ThemeResource HavenWarningTintColor}" />
            <SolidColorBrush x:Key="DangerTintBrush" Color="{ThemeResource HavenDangerTintColor}" />

            <!-- Interaction brushes keep their historic Haven names. -->
            <SolidColorBrush x:Key="HavenAccentBrush" Color="{ThemeResource HavenAccentColor}" />
            <SolidColorBrush x:Key="HavenVioletBrush" Color="{ThemeResource HavenVioletColor}" />
            <SolidColorBrush x:Key="HavenOrangeBrush" Color="{ThemeResource HavenOrangeColor}" />
            <SolidColorBrush x:Key="HavenSuccessBrush" Color="{ThemeResource HavenSuccessColor}" />
            <SolidColorBrush x:Key="HavenWarningBrush" Color="{ThemeResource HavenWarningColor}" />
            <SolidColorBrush x:Key="HavenDangerBrush" Color="{ThemeResource HavenDangerColor}" />
            <SolidColorBrush x:Key="HavenAccentTintBrush" Color="{ThemeResource HavenAccentTintColor}" />
            <SolidColorBrush x:Key="HavenVioletTintBrush" Color="{ThemeResource HavenVioletTintColor}" />
            <SolidColorBrush x:Key="HavenOrangeTintBrush" Color="{ThemeResource HavenOrangeTintColor}" />
            <SolidColorBrush x:Key="HavenSuccessTintBrush" Color="{ThemeResource HavenSuccessTintColor}" />
            <SolidColorBrush x:Key="HavenWarningTintBrush" Color="{ThemeResource HavenWarningTintColor}" />
            <SolidColorBrush x:Key="HavenDangerTintBrush" Color="{ThemeResource HavenDangerTintColor}" />

            <!-- Data-visualization series and heat ramp (spec 37).  Each theme
                 defines its own eight-slot Series1-8Color set (fixed hue
                 order, CVD-validated); heat stays on the fixed status tints
                 since status color never follows the theme. -->
            <SolidColorBrush x:Key="Series1Brush" Color="{ThemeResource Series1Color}" />
            <SolidColorBrush x:Key="Series2Brush" Color="{ThemeResource Series2Color}" />
            <SolidColorBrush x:Key="Series3Brush" Color="{ThemeResource Series3Color}" />
            <SolidColorBrush x:Key="Series4Brush" Color="{ThemeResource Series4Color}" />
            <SolidColorBrush x:Key="Series5Brush" Color="{ThemeResource Series5Color}" />
            <SolidColorBrush x:Key="Series6Brush" Color="{ThemeResource Series6Color}" />
            <SolidColorBrush x:Key="Series7Brush" Color="{ThemeResource Series7Color}" />
            <SolidColorBrush x:Key="Series8Brush" Color="{ThemeResource Series8Color}" />
            <SolidColorBrush x:Key="HeatLowBrush" Color="{ThemeResource HavenSuccessTintColor}" />
            <SolidColorBrush x:Key="HeatMedBrush" Color="{ThemeResource HavenWarningTintColor}" />
            <SolidColorBrush x:Key="HeatHighBrush" Color="{ThemeResource HavenDangerTintColor}" />

            <!-- Typography scale (spec section 05). Sentence case in copy. -->
            <Style x:Key="HavenDisplayTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource HavenTextBrush}" />
            </Style>
            <Style x:Key="HavenPageTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource HavenTextBrush}" />
            </Style>
            <Style x:Key="HavenSectionTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource HavenTextBrush}" />
            </Style>
            <Style x:Key="HavenBodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="{ThemeResource HavenTextBrush}" />
            </Style>
            <Style x:Key="HavenMetadataTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource HavenMutedTextBrush}" />
            </Style>
            <Style x:Key="HavenMonoTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Cascadia Mono" />
                <Setter Property="Foreground" Value="{ThemeResource HavenTextBrush}" />
            </Style>

            <!-- Cards (spec 06/13): raised rounded surface, thin stroke. -->
            <Style x:Key="HavenCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource HavenSurface2Brush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HavenStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <!-- Button hierarchy (spec 12). -->
            <Style x:Key="HavenButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource HavenSurface2Brush}" />
                <Setter Property="Foreground" Value="{ThemeResource HavenTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource HavenStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,5" />
            </Style>
            <Style x:Key="HavenPrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource HavenAccentBrush}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="14,5" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="HavenSecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource HavenStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource HavenTextBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,5" />
            </Style>
            <Style x:Key="HavenQuietButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource HavenAccentBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="10,4" />
            </Style>
            <Style x:Key="HavenDangerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource HavenDangerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource HavenDangerBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="12,5" />
            </Style>

            <!-- Circular icon button (mic affordance, send). -->
            <Style x:Key="HavenCircleButtonStyle" TargetType="Button">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource HavenMutedTextBrush}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- In-page tab row (Home domains, Models sources). -->
            <Style x:Key="HavenTabButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource HavenMutedTextBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,2" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="MinHeight" Value="34" />
            </Style>

            <!-- Rail navigation item (spec 08): 36-40px rows, hover surface,
                 selected = filled blue rounded pill. -->
            <Style x:Key="HavenNavItemStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource HavenMutedTextBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Margin" Value="10,1" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- Dense list rows with hover and selected states (spec 13/14). -->
            <Style x:Key="HavenListItemStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Margin" Value="2,1" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <!-- Search/result list rows. -->
            <Style x:Key="HavenRowListStyle" TargetType="ListView">
                <Setter Property="SelectionMode" Value="None" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource HavenListItemStyle}" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
